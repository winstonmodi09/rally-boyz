rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in club member can read and write. Fine for a small friendly club;
    // anyone who signs up with the link can edit data, so don't share the link publicly.
    match /players/{id} { allow read, write: if request.auth != null; }
    match /matches/{id} { allow read, write: if request.auth != null; }
  }
}
